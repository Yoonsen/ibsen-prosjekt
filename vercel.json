{
  "builds": [
    {
      "src": "api.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 300,
        "memory": 3008
      }
    },
    {
      "src": "web/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api.py"
    },
    {
      "src": "/(.*)",
      "dest": "/web/$1"
    }
  ]
}
